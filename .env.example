# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Адрес сайта для Caddy. Для внутреннего сервера без домена оставьте :80,
# для домена с сертификатом Let's Encrypt укажите reports.example.ru
SITE_ADDRESS=:80

# База
POSTGRES_USER=reports
POSTGRES_PASSWORD=
POSTGRES_DB=reports

# Ключ подписи сессионных cookie. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Часовой пояс, в котором считается «сегодня»
APP_TIMEZONE=Europe/Moscow

# Сколько дней сотрудник может править свой отчёт
EDIT_WINDOW_DAYS=3

# true, если сайт работает по https. Для :80 без сертификата поставьте false,
# иначе cookie не установится и вход не сработает.
COOKIE_SECURE=true
