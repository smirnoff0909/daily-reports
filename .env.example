# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Порт на 127.0.0.1, куда фронтовой веб-сервер проксирует запросы.
# Наружу приложение не слушает. Смените, если 8000 уже занят соседним сайтом.
APP_PORT=8000

# База
POSTGRES_USER=reports
POSTGRES_PASSWORD=
POSTGRES_DB=reports

# Ключ подписи сессионных cookie. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Часовой пояс, в котором считается «сегодня»
APP_TIMEZONE=Europe/Moscow

# true, если сайт работает по https. Для :80 без сертификата поставьте false,
# иначе cookie не установится и вход не сработает.
COOKIE_SECURE=true
